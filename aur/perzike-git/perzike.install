# Colored makepkg-like functions
note() {
    printf "${_blue}==>${_yellow} NOTE:${_bold} %s${_all_off}\n" "$1"
}

_all_off="$(tput sgr0)"
_bold="${_all_off}$(tput bold)"
_blue="${_bold}$(tput setaf 4)"
_yellow="${_bold}$(tput setaf 3)"

post_install() {
    note "Custom flags should be put directly in: ~/.config/perzike-flags.conf"
    note "The launcher is called: 'perzike'"
}

pre_remove() {
    if [ -f '/opt/perzike/resources/files/uninstall-service.sh' ]; then
        /bin/sh '/opt/perzike/resources/files/uninstall-service.sh'
    elif [ -x '/opt/perzike/resources/files/perzike-service' ]; then
        '/opt/perzike/resources/files/perzike-service' service uninstall
    fi
}
